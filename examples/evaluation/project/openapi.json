{
  "openapi": "3.0.3",
  "info": {
    "title": "Synthetic evaluation API",
    "version": "evaluation-v1"
  },
  "x-code-version": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "paths": {
    "/signup": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "userId",
                  "displayName"
                ],
                "properties": {
                  "userId": {
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  }
}
