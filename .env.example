NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
TRACEBRIDGE_INVESTIGATION_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional registered local log file; the model cannot choose its path.
# TRACEBRIDGE_LOG_FILE=C:/path/to/application.log
# Registration describes this source; reporter/model guesses never fill log metadata.
# TRACEBRIDGE_LOG_SERVICE=backend
# TRACEBRIDGE_LOG_ENVIRONMENT=dev
# Timezone for naive file timestamps only (UTC or +/-HH:MM).
# TRACEBRIDGE_LOG_TIMEZONE=+09:00
# Optional explicitly supplied replay catalog for the same UI/CLI rule path.
# TRACEBRIDGE_EVENTS_FILE=C:/path/to/events.json
# Local incident records and reviewed clues; default is inside this workspace.
# TRACEBRIDGE_DB_PATH=output/tracebridge/incidents.sqlite3
# Manual SHA only. A running Docker revision label is collected separately on opt-in.
# TRACEBRIDGE_DEPLOYED_SHA=0123456789abcdef
# Optional self-hosted NeMo Retriever OCR. Hosted OCR uses NVIDIA_API_KEY.
# TRACEBRIDGE_OCR_URL=http://localhost:8000/v1/ocr
# TRACEBRIDGE_OCR_API_KEY=your_internal_ocr_key
