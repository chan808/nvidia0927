{$TRACEBRIDGE_DOMAIN} {
    handle / {
        rewrite * /welcome
        reverse_proxy guard:8080
    }
    handle /review/* {
        reverse_proxy guard:8080
    }
    handle /report/* {
        reverse_proxy guard:8080
    }
    handle /v1/* {
        reverse_proxy guard:8080
    }
    handle {
        basic_auth {
            {$CADDY_USERNAME} {$CADDY_PASSWORD_HASH}
        }
        reverse_proxy web:8501
    }
}
