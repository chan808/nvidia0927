# Copy to deploy/.env on the Linux server. No real secrets belong in Git.
# Use a DNS hostname only, without https://, path, or trailing slash.
TRACEBRIDGE_DOMAIN=tracebridge.example.com
ACME_EMAIL=owner@example.com
CADDY_USERNAME=reviewer
# Generate interactively: sudo docker run --rm -it caddy:2-alpine caddy hash-password
# Use single quotes around the complete hash so Compose preserves its '$'.
CADDY_PASSWORD_HASH='REPLACE_WITH_CADDY_HASH'
STREAMLIT_SERVER_COOKIE_SECRET=REPLACE_WITH_RANDOM_SECRET
TRACEBRIDGE_DATA_DIR=/srv/tracebridge/data

# First deployment: set to the release commit, e.g. tracebridge:<commit>.
TRACEBRIDGE_IMAGE=tracebridge:preview
TRACEBRIDGE_REVISION=REPLACE_WITH_COMMIT_SHA
# These tags are convenient for the initial build. Record the tested image IDs
# and pin base/proxy digests for subsequent builds, as described in the guide.
PYTHON_IMAGE=python:3.12-slim-bookworm
CADDY_IMAGE=caddy:2-alpine

# Shared-host deployment only: use compose.shared.yaml and the existing Nginx.
# TRACEBRIDGE_INGRESS_NETWORK=docker_agolive-net

# Optional PostgreSQL + pgvector overlay. These are file paths, not secret values.
# TRACEBRIDGE_POSTGRES_PASSWORD_FILE=/srv/tracebridge/private/postgres-password
# TRACEBRIDGE_DATABASE_URL_SECRET_FILE=/srv/tracebridge/private/database-url
# URL file content: postgresql://tracebridge:URL_ENCODED_PASSWORD@postgres:5432/tracebridge
