# Copy to deploy/app.env. The web and optional control containers read this file.
# The paired PC runner does not receive NVIDIA credentials.
# Leave empty for an offline, private preview. Live NVIDIA checks are separate.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
TRACEBRIDGE_INVESTIGATION_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional retrieval embeddings are disabled independently of chat/OCR keys.
# Configure a NIM /v1 endpoint and its served model, then opt in to indexing.
TRACEBRIDGE_EMBEDDINGS_ENABLED=0
# TRACEBRIDGE_EMBEDDING_URL=https://your-nim-service.example/v1
# TRACEBRIDGE_EMBEDDING_MODEL=your-served-embedding-model
# TRACEBRIDGE_EMBEDDING_API_KEY=
# Enable the rag Compose profile to run the owner-requested indexing worker.
# PostgreSQL overlay mounts its database URL as a secret file automatically.

# A local OCR URL such as localhost:8000 would refer to this container.
# The default hosted NeMo OCR endpoint does not require this override.
# TRACEBRIDGE_OCR_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2

# The deployed preview uses its bundled trusted seed. Developer project paths,
# runner credentials and Docker socket mounts belong to the local runner.
